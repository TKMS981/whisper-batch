<Window x:Class="WhisperBatch.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:WhisperBatch.App.Infrastructure"
        Title="{l:L settings.title}" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{StaticResource AppFont}">
    <!-- 設定: 表示言語 -->
    <StackPanel Margin="24,20">
        <TextBlock Text="{l:L settings.appLanguage}" FontWeight="SemiBold" Margin="0,0,0,8" />
        <StackPanel x:Name="Choices" Margin="4,0,0,0" />
        <TextBlock Text="{l:L settings.appLanguage.note}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
        <Button Content="{l:L common.close}" IsCancel="True" IsDefault="True" MinWidth="96" HorizontalAlignment="Right" Margin="0,18,0,0" />
    </StackPanel>
</Window>
