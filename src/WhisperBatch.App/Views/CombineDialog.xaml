<Window x:Class="WhisperBatch.App.Views.CombineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:WhisperBatch.App.Infrastructure"
        Title="{l:L combine.title}" Width="600" Height="560" MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="{DynamicResource AppFont}" FontSize="{DynamicResource Size.14}">
    <DockPanel Margin="20">
        <!-- 含める結果と順序を決めて 1 つのテキストファイルに保存する -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{l:L combine.title}" Style="{StaticResource Title}" />
            <TextBlock Text="{l:L combine.message}" Style="{StaticResource Secondary}" Margin="0,6,0,12" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{l:L common.cancel}" IsCancel="True" MinWidth="96" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="{l:L combine.save}" IsDefault="True" MinWidth="96" Click="OnSave" Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
            <TextBlock x:Name="Summary" Style="{StaticResource Caption}" VerticalAlignment="Center" />
        </DockPanel>

        <Border DockPanel.Dock="Bottom" x:Name="ErrorBox" Visibility="Collapsed" Margin="0,10,0,0" Padding="8" CornerRadius="6"
                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            </DockPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Button Content="{l:L combine.selectAll}" Click="OnSelectAll" Style="{StaticResource SmallButton}" Margin="0,0,6,0" />
                <Button Content="{l:L combine.deselectAll}" Click="OnDeselectAll" Style="{StaticResource SmallButton}" />
            </StackPanel>
            <CheckBox x:Name="Timestamps" Content="{l:L combine.timestamps}" HorizontalAlignment="Right" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
            <Button x:Name="UpButton" Click="OnMoveUp" Padding="8,6" Margin="0,0,0,6" ToolTip="{l:L combine.moveUp.help}" AutomationProperties.Name="{l:L combine.moveUp}">
                <TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" />
            </Button>
            <Button x:Name="DownButton" Click="OnMoveDown" Padding="8,6" ToolTip="{l:L combine.moveDown.help}" AutomationProperties.Name="{l:L combine.moveDown}">
                <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" />
            </Button>
        </StackPanel>

        <ListBox x:Name="Rows" SelectionMode="Single" HorizontalContentAlignment="Stretch" ItemContainerStyle="{StaticResource SubtleListItem}" SelectionChanged="OnRowSelected" KeyDown="OnRowsKeyDown"
                 AutomationProperties.Name="{l:L combine.list.accessibility}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Included}" Click="OnIncludeChanged" VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding IncludeLabel}" MinWidth="0" Margin="0,0,4,0" />
                        <TextBlock DockPanel.Dock="Left" Text="{Binding Order}" MinWidth="28" TextAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontFamily="{StaticResource MonoDigits}" />
                        <TextBlock x:Name="Name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Included}" Value="False">
                            <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
