<Window x:Class="WhisperBatch.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:WhisperBatch.App.Infrastructure"
        xmlns:v="clr-namespace:WhisperBatch.App.Views"
        x:Name="Root"
        Title="Whisper Batch"
        Width="1080" Height="720" MinWidth="720" MinHeight="500"
        FontFamily="{StaticResource AppFont}"
        AllowDrop="True"
        Icon="/AppIcon.ico">
    <Window.Resources>
        <!-- キューの行の右クリックメニュー -->
        <ContextMenu x:Key="RowMenu">
            <MenuItem Header="{l:L queue.menu.retry}" Click="OnRowRetry" Tag="retry" />
            <MenuItem Header="{l:L queue.menu.reveal}" Click="OnRowReveal" Tag="reveal" />
            <MenuItem Header="{l:L mp3.save}" Click="OnRowSaveMp3" Tag="mp3" />
            <Separator />
            <MenuItem Header="{l:L queue.menu.remove}" Click="OnRowRemove" Tag="remove" />
        </ContextMenu>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding AddFilesCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding AddFolderCommand}" />
        <KeyBinding Gesture="Ctrl+R" Command="{Binding StartCommand}" />
        <KeyBinding Key="OemPeriod" Modifiers="Ctrl" Command="{Binding CancelCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding CombineCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+M" Command="{Binding ManageModelsCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding SettingsCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FindCommand}" />
    </Window.InputBindings>

    <Grid>
        <DockPanel>
            <!-- メニューとツールバー -->
            <Grid DockPanel.Dock="Top" Background="{DynamicResource LayerFillColorAltBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Menu Grid.Column="0" Background="Transparent" VerticalAlignment="Center">
                    <MenuItem Header="{l:L menu.file}">
                        <MenuItem Header="{l:L menu.addFiles}" InputGestureText="Ctrl+O" Command="{Binding AddFilesCommand}" />
                        <MenuItem Header="{l:L menu.addFolder}" InputGestureText="Ctrl+Shift+O" Command="{Binding AddFolderCommand}" />
                        <Separator />
                        <MenuItem Header="{l:L menu.settings}" InputGestureText="Ctrl+," Command="{Binding SettingsCommand}" />
                        <Separator />
                        <MenuItem Header="{l:L menu.exit}" InputGestureText="Alt+F4" Click="OnExitClick" />
                    </MenuItem>
                    <MenuItem Header="{l:L menu.transcription}">
                        <MenuItem Header="{l:L action.start}" InputGestureText="Ctrl+R" Command="{Binding StartCommand}" />
                        <MenuItem Header="{l:L action.cancel}" InputGestureText="Ctrl+." Command="{Binding CancelCommand}" />
                        <Separator />
                        <MenuItem Header="{l:L action.combine}" InputGestureText="Ctrl+Shift+S" Command="{Binding CombineCommand}" />
                        <Separator />
                        <MenuItem Header="{l:L action.manageModels}" InputGestureText="Ctrl+Alt+M" Command="{Binding ManageModelsCommand}" />
                    </MenuItem>
                    <MenuItem Header="{l:L menu.help}">
                        <MenuItem Header="{l:L menu.thirdParty}" Click="OnNoticesClick" />
                        <MenuItem Header="{l:L menu.about}" Click="OnAboutClick" />
                    </MenuItem>
                </Menu>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,4,8,4">
                    <Button Command="{Binding AddFilesCommand}" ToolTip="{l:L toolbar.addFiles.help}" Margin="0,0,6,0"
                            AutomationProperties.Name="{l:L toolbar.addFiles}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" Style="{StaticResource ButtonGlyph}" />
                            <TextBlock Text="{l:L toolbar.addFiles}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding StartCommand}" ToolTip="{Binding Model.StartHelp}" AutomationProperties.Name="{l:L action.start}" Visibility="{Binding Model.IsRunning, Converter={StaticResource NotVisible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource ButtonGlyph}" />
                            <TextBlock Text="{l:L action.start}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding CancelCommand}" ToolTip="{l:L toolbar.cancel.help}" AutomationProperties.Name="{l:L action.cancel}" Visibility="{Binding Model.IsRunning, Converter={StaticResource Visible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" Style="{StaticResource ButtonGlyph}" />
                            <TextBlock Text="{l:L action.cancel}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="320" MinWidth="260" MaxWidth="480" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- 左側: ファイル追加の案内と処理キュー -->
                <Border Grid.Column="0" Background="{DynamicResource LayerFillColorDefaultBrush}">
                    <Grid>
                        <!-- キューが空のとき -->
                        <Border Margin="12" CornerRadius="12" BorderThickness="1"
                                Visibility="{Binding Model.IsQueueEmpty, Converter={StaticResource Visible}}"
                                AutomationProperties.Name="{l:L queue.dropArea.accessibility}">
                            <Border.BorderBrush>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Rectangle StrokeDashArray="6 4" StrokeThickness="1" RadiusX="12" RadiusY="12"
                                                   Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                                                   Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Border.BorderBrush>
                            <StackPanel VerticalAlignment="Center" Margin="20">
                                <TextBlock Text="&#xE8D6;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,14" />
                                <TextBlock Text="{l:L queue.empty.title}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                <TextBlock Text="{l:L queue.empty.message}" Style="{StaticResource Secondary}" TextAlignment="Center" Margin="0,8,0,14" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="{l:L action.addFilesEllipsis}" Command="{Binding AddFilesCommand}" Style="{DynamicResource AccentButtonStyle}" Padding="16,6" />
                                    <Button Content="{l:L action.addFolderEllipsis}" Command="{Binding AddFolderCommand}" Padding="16,6" Margin="8,0,0,0" />
                                </StackPanel>
                                <Path Style="{StaticResource Spinner}" Margin="0,12,0,0" Visibility="{Binding Model.IsAddingFiles, Converter={StaticResource Visible}}" />
                                <TextBlock Text="{Binding Model.FormatsText}" Style="{StaticResource Caption}" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextAlignment="Center" Margin="0,14,0,0" />
                                <TextBlock Text="{Binding Model.AddNotice}" Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                           TextAlignment="Center" Margin="0,10,0,0" Visibility="{Binding Model.AddNotice, Converter={StaticResource NotEmpty}}" />
                            </StackPanel>
                        </Border>

                        <!-- キューに項目があるとき -->
                        <DockPanel Visibility="{Binding Model.HasItems, Converter={StaticResource Visible}}">
                            <!-- どこにでもドロップできることの案内 -->
                            <Border DockPanel.Dock="Top" Margin="10,8" Padding="10,6" CornerRadius="8" BorderThickness="1"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    AutomationProperties.Name="{l:L queue.dropArea.accessibility}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,8,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Button DockPanel.Dock="Right" Content="{l:L action.addShort}" Command="{Binding AddFilesCommand}" Style="{StaticResource SmallButton}" />
                                    <Path DockPanel.Dock="Right" Style="{StaticResource Spinner}" Margin="0,0,8,0" Visibility="{Binding Model.IsAddingFiles, Converter={StaticResource Visible}}" />
                                    <TextBlock Text="{Binding Model.DropStripText}" Style="{StaticResource Secondary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>

                            <!-- 追加時のお知らせ -->
                            <Border DockPanel.Dock="Top" Margin="10,0,10,6" Padding="8" CornerRadius="6"
                                    Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                                    Visibility="{Binding Model.AddNotice, Converter={StaticResource NotEmpty}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,1,8,0"
                                               Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Button DockPanel.Dock="Right" Click="OnDismissNotice" Padding="4" VerticalAlignment="Top" Background="Transparent" BorderThickness="0"
                                            AutomationProperties.Name="{l:L notice.close}" ToolTip="{l:L notice.close}">
                                        <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10" />
                                    </Button>
                                    <TextBox Text="{Binding Model.AddNotice, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12"
                                             BorderThickness="0" Background="Transparent" Padding="0" MaxHeight="110" VerticalScrollBarVisibility="Auto" />
                                </DockPanel>
                            </Border>

                            <!-- 下部: 削除・一括操作・件数 -->
                            <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="8,4">
                                <DockPanel>
                                    <Button DockPanel.Dock="Left" Click="OnRemoveSelected" IsEnabled="{Binding Model.CanRemoveSelected}" Padding="8,4"
                                            ToolTip="{l:L queue.footer.remove.help}" AutomationProperties.Name="{l:L queue.footer.remove}">
                                        <TextBlock Text="&#xE738;" Style="{StaticResource Icon}" FontSize="12" />
                                    </Button>
                                    <Button x:Name="QueueMenuButton" DockPanel.Dock="Left" Click="OnQueueMenu" Padding="8,4" Margin="4,0,0,0"
                                            AutomationProperties.Name="{l:L queue.footer.menu}" ToolTip="{l:L queue.footer.menu}">
                                        <TextBlock Text="&#xE712;" Style="{StaticResource Icon}" FontSize="12" />
                                        <Button.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{l:L queue.footer.removePending}" Click="OnRemovePending" IsEnabled="{Binding Model.CanRemoveAllPending}" />
                                                <MenuItem Header="{l:L queue.footer.removeAll}" Click="OnRemoveAll" IsEnabled="{Binding Model.CanRemoveAll}" />
                                                <Separator />
                                                <MenuItem Header="{l:L queue.footer.retryFailed}" Click="OnRetryFailed" IsEnabled="{Binding Model.CanRetryFailed}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <TextBlock Text="{Binding Model.FooterSummary}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,4,0" />
                                </DockPanel>
                            </Border>

                            <!-- 処理キュー -->
                            <ListBox x:Name="QueueList" ItemsSource="{Binding Model.Items}" SelectionMode="Extended" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                                     SelectionChanged="OnQueueSelectionChanged" KeyDown="OnQueueKeyDown"
                                     AutomationProperties.Name="{l:L queue.accessibility}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource SubtleListItem}">
                                        <Setter Property="l:Motion.EnterOnLoad" Value="True" />
                                        <Setter Property="ToolTip" Value="{Binding HelpText}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                        <Setter Property="AutomationProperties.HelpText" Value="{Binding Subtitle}" />
                                        <EventSetter Event="ContextMenuOpening" Handler="OnRowContextMenuOpening" />
                                        <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <v:StatusIcon Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="&#xE714;" Style="{StaticResource Icon}" FontSize="12" Margin="6,0,0,0"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" ToolTip="{l:L queue.row.video.help}"
                                                               Visibility="{Binding IsVideo, Converter={StaticResource Visible}}" />
                                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock x:Name="Sub" Text="{Binding Subtitle}" Style="{StaticResource Caption}" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="3" Margin="0,5,0,1"
                                                             Visibility="{Binding IsProcessing, Converter={StaticResource Visible}}" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource DividerStrokeColorDefaultBrush}" Focusable="False" />

                <!-- 右側: 設定（上）・結果（中央）・保存操作（下） -->
                <DockPanel Grid.Column="2" x:Name="DetailColumn">
                    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="14,12">
                        <v:RecognitionSettingsPanel />
                    </Border>
                    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="14,10">
                        <v:ExportActionBar />
                    </Border>
                    <v:TranscriptDetail x:Name="Detail" />
                </DockPanel>
            </Grid>
        </DockPanel>

        <!-- ドラッグ中に重ねる表示（クリックやスクロールは下のビューに通す） -->
        <Grid x:Name="DropOverlay" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0"
              l:Motion.FadeVisible="{Binding Model.IsDropTargeted}">
            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.07" />
            <Border BorderThickness="3" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" />
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="22" Padding="18,12"
                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    <TextBlock Text="{l:L drop.overlay}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
